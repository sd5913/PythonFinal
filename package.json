{
  "name": "pythonfinal-worker",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev --local",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "test:worker": "node scripts/test-worker.mjs",
    "assets": "node scripts/prepare-assets.mjs",
    "predev": "npm run assets",
    "pretest:worker": "npm run assets",
    "deploy": "npm run assets && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.160.0",
    "ws": "8.21.0"
  }
}
